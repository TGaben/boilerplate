includes:
    - ./vendor/nunomaduro/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - config
        - database
        - routes
        - tests
    
    # Laravel specific configurations
    bootstrapFiles:
        - vendor/autoload.php
    
    # Keep only actively used patterns - temporary until we fix the actual issues
    ignoreErrors:
        - '#Cannot cast mixed to (string|int)\.#'
        - '#Binary operation "\." between .* and .* results in an error\.#'

    
    # Exclude generated files and vendor
    excludePaths:
        - vendor
        - node_modules (?)
        - storage
        - bootstrap/cache
        - *.blade.php
        - database/migrations/2025_08_02_131418_create_permission_tables.php
    
    # Additional rules for better analysis
    checkNullables: true
    checkThisOnly: false
    checkUnionTypes: true
    checkExplicitMixed: true
    checkFunctionNameCase: true