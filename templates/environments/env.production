# ====================================
# PRODUCTION Environment Template
# ====================================
# IMPORTANT: Replace all placeholder values before deployment!
# Security and performance optimized for production

# Laravel Core Configuration (Production)
APP_NAME="Laravel Boilerplate"
APP_ENV=production
APP_KEY=REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com

# Localization (Production)
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Application Assets and Branding (Production)
APP_LOGO_LIGHT=/images/logo.svg
APP_LOGO_DARK=/images/logo-dark.svg
APP_FAVICON=/favicon.ico
BRAND_PRIMARY_COLOR=#3b82f6
BRAND_SECONDARY_COLOR=#64748b

# Database Configuration (Production - MySQL/PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_DB_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DB_NAME
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Session and Cache Configuration (Production)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIES=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=prod_boilerplate_

# Queue Configuration (Production - Redis/Database)
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=s3

# Mail Configuration (Production - SMTP/SES)
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Redis Configuration (Production - Required)
REDIS_CLIENT=phpredis
REDIS_HOST=REPLACE_WITH_REDIS_HOST
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0

# AWS Configuration (Production - for S3, SES, etc.)
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=REPLACE_WITH_S3_BUCKET_NAME
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Configuration (Production)
VITE_APP_NAME="${APP_NAME}"

# ====================================
# BOILERPLATE FEATURES (Production - Optimized)
# ====================================

# Core Features (Production optimized)
BOILERPLATE_DEMO_UI=false
BOILERPLATE_ACTIVITY_LOG=true
BOILERPLATE_STRICT_PERMISSIONS=true
BOILERPLATE_MULTI_LANGUAGE=true
BOILERPLATE_THEME_SWITCHING=true

# Admin Panel Configuration (Production)
ADMIN_LOCALE=hu
ADMIN_ITEMS_PER_PAGE=25
ADMIN_ENABLE_AVATARS=true
ADMIN_ENABLE_GLOBAL_SEARCH=true
ADMIN_ENABLE_DB_NOTIFICATIONS=true
ADMIN_SIDEBAR_COLLAPSED=false

# UI Theme Configuration (Production)
UI_DEFAULT_THEME=light
UI_ENABLE_THEME_TOGGLE=true
UI_PRESERVE_THEME_CHOICE=true

# Demo UI Kit Configuration (Production - DISABLED)
DEMO_SHOW_BUTTONS=false
DEMO_SHOW_CARDS=false
DEMO_SHOW_FORMS=false
DEMO_SHOW_ALERTS=false
DEMO_SHOW_MODALS=false
DEMO_SHOW_NAVIGATION=false
DEMO_SHOW_TYPOGRAPHY=false
DEMO_SHOW_LAYOUTS=false
DEMO_SHOW_TABLES=false
DEMO_SHOW_BADGES=false
DEMO_SHOW_AVATARS=false
DEMO_SHOW_PROGRESS=false
DEMO_SHOW_TABS=false
DEMO_SHOW_DROPDOWNS=false
DEMO_SHOW_PAGINATION=false
DEMO_SHOW_CODE=false
DEMO_ENABLE_CLIPBOARD=false
DEMO_SYNTAX_HIGHLIGHTING=false

# Performance Configuration (Production - ENABLED)
PERFORMANCE_LAZY_LOAD=true
PERFORMANCE_PRELOAD_CSS=true
PERFORMANCE_OPTIMIZE_IMAGES=true
PERFORMANCE_RESPONSE_CACHE=true
PERFORMANCE_CACHE_DURATION=3600

# Security Configuration (Production - STRICT)
SECURITY_PASSWORD_HISTORY=true
SECURITY_PASSWORD_HISTORY_COUNT=5
SECURITY_FORCE_PASSWORD_CHANGE=90
SECURITY_LOG_LOGIN_ATTEMPTS=true
SECURITY_MAX_LOGIN_ATTEMPTS=3
SECURITY_LOCKOUT_MINUTES=30

# Development Configuration (Production - DISABLED)
BOILERPLATE_DEBUG_INFO=false
BOILERPLATE_QUERY_LOG=false
BOILERPLATE_ROUTE_INFO=false
BOILERPLATE_PROFILING=false

# Laravel Production Configuration
LOG_LEVEL=error
LOG_CHANNEL=stack
LOG_STACK=single,slack
LOG_SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK_URL

# Security Headers
APP_FORCE_HTTPS=true
APP_SECURE_HEADERS=true

# Error Tracking (Optional - Sentry, Bugsnag, etc.)
SENTRY_LARAVEL_DSN=REPLACE_WITH_SENTRY_DSN
SENTRY_TRACES_SAMPLE_RATE=0.1

# Production Tools (Disabled)
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# Backup Configuration (if using Laravel Backup)
BACKUP_ARCHIVE_PASSWORD=REPLACE_WITH_BACKUP_PASSWORD
BACKUP_NOTIFICATION_SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK_URL

# Health Check Configuration
HEALTH_CHECK_SECRET=REPLACE_WITH_HEALTH_CHECK_SECRET
