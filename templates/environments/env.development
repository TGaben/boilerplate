# ====================================
# DEVELOPMENT Environment Template
# ====================================
# Copy this file to .env for local development
# All debugging and development features enabled

# Laravel Core Configuration
APP_NAME="Laravel Boilerplate Dev"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Localization (Development - Hungarian default)
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

# Application Assets and Branding (Development)
APP_LOGO_LIGHT=/images/logo.svg
APP_LOGO_DARK=/images/logo-dark.svg
APP_FAVICON=/favicon.ico
BRAND_PRIMARY_COLOR=#3b82f6
BRAND_SECONDARY_COLOR=#64748b

# Database Configuration (Development - MySQL via Sail)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# Testing Database (SQLite for faster tests)
DB_CONNECTION_TESTING=sqlite
DB_DATABASE_TESTING=:memory:

# Session and Cache Configuration (Development)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=dev_

# Queue Configuration (Development - sync for immediate processing)
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Configuration (Development - Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="dev@boilerplate.local"
MAIL_FROM_NAME="${APP_NAME}"

# Redis Configuration (Optional - via Sail)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Vite Configuration (Development)
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_KEY=
VITE_DEV_SERVER_CERT=

# ====================================
# BOILERPLATE FEATURES (Development - ALL ENABLED)
# ====================================

# Core Features
BOILERPLATE_DEMO_UI=true
BOILERPLATE_ACTIVITY_LOG=true
BOILERPLATE_STRICT_PERMISSIONS=false
BOILERPLATE_MULTI_LANGUAGE=true
BOILERPLATE_THEME_SWITCHING=true

# Admin Panel Configuration (Development)
ADMIN_LOCALE=hu
ADMIN_ITEMS_PER_PAGE=10
ADMIN_ENABLE_AVATARS=true
ADMIN_ENABLE_GLOBAL_SEARCH=true
ADMIN_ENABLE_DB_NOTIFICATIONS=true
ADMIN_SIDEBAR_COLLAPSED=false

# UI Theme Configuration (Development)
UI_DEFAULT_THEME=light
UI_ENABLE_THEME_TOGGLE=true
UI_PRESERVE_THEME_CHOICE=true

# Demo UI Kit Configuration (Development - ALL ENABLED)
DEMO_SHOW_BUTTONS=true
DEMO_SHOW_CARDS=true
DEMO_SHOW_FORMS=true
DEMO_SHOW_ALERTS=true
DEMO_SHOW_MODALS=true
DEMO_SHOW_NAVIGATION=true
DEMO_SHOW_TYPOGRAPHY=true
DEMO_SHOW_LAYOUTS=true
DEMO_SHOW_TABLES=true
DEMO_SHOW_BADGES=true
DEMO_SHOW_AVATARS=true
DEMO_SHOW_PROGRESS=true
DEMO_SHOW_TABS=true
DEMO_SHOW_DROPDOWNS=true
DEMO_SHOW_PAGINATION=true
DEMO_SHOW_CODE=true
DEMO_ENABLE_CLIPBOARD=true
DEMO_SYNTAX_HIGHLIGHTING=true

# Performance Configuration (Development - Debug over Performance)
PERFORMANCE_LAZY_LOAD=false
PERFORMANCE_PRELOAD_CSS=false
PERFORMANCE_OPTIMIZE_IMAGES=false
PERFORMANCE_RESPONSE_CACHE=false
PERFORMANCE_CACHE_DURATION=0

# Security Configuration (Development - Relaxed)
SECURITY_PASSWORD_HISTORY=false
SECURITY_PASSWORD_HISTORY_COUNT=3
SECURITY_FORCE_PASSWORD_CHANGE=0
SECURITY_LOG_LOGIN_ATTEMPTS=true
SECURITY_MAX_LOGIN_ATTEMPTS=10
SECURITY_LOCKOUT_MINUTES=5

# Development Configuration (ENABLED for debugging)
BOILERPLATE_DEBUG_INFO=true
BOILERPLATE_QUERY_LOG=true
BOILERPLATE_ROUTE_INFO=true
BOILERPLATE_PROFILING=true

# Laravel Debugging
LOG_LEVEL=debug
LOG_CHANNEL=daily
LOG_STACK=single,daily

# Additional Development Tools
DEBUGBAR_ENABLED=true
TELESCOPE_ENABLED=false
