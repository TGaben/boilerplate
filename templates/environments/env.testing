# ====================================
# TESTING Environment Template
# ====================================
# Copy this file to .env.testing for running tests
# Optimized for fast, isolated testing

# Laravel Core Configuration (Testing)
APP_NAME="Laravel Boilerplate Tests"
APP_ENV=testing
APP_KEY=base64:TESTING_KEY_REPLACE_THIS_VALUE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Localization (Testing - English for consistency)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Application Assets and Branding (Testing - simplified)
APP_LOGO_LIGHT=/images/logo.svg
APP_LOGO_DARK=/images/logo-dark.svg
APP_FAVICON=/favicon.ico
BRAND_PRIMARY_COLOR=#3b82f6
BRAND_SECONDARY_COLOR=#64748b

# Database Configuration (Testing - In-memory SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# Session and Cache Configuration (Testing - Array drivers)
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=array
CACHE_PREFIX=test_

# Queue Configuration (Testing - Synchronous)
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Configuration (Testing - Array driver)
MAIL_MAILER=array
MAIL_FROM_ADDRESS="test@boilerplate.local"
MAIL_FROM_NAME="${APP_NAME}"

# Redis Configuration (Testing - Mock/Array)
REDIS_CLIENT=array

# Vite Configuration (Testing)
VITE_APP_NAME="${APP_NAME}"

# ====================================
# BOILERPLATE FEATURES (Testing - Disabled for Speed)
# ====================================

# Core Features (Minimal for testing)
BOILERPLATE_DEMO_UI=false
BOILERPLATE_ACTIVITY_LOG=false
BOILERPLATE_STRICT_PERMISSIONS=true
BOILERPLATE_MULTI_LANGUAGE=false
BOILERPLATE_THEME_SWITCHING=false

# Admin Panel Configuration (Testing)
ADMIN_LOCALE=en
ADMIN_ITEMS_PER_PAGE=10
ADMIN_ENABLE_AVATARS=false
ADMIN_ENABLE_GLOBAL_SEARCH=false
ADMIN_ENABLE_DB_NOTIFICATIONS=false
ADMIN_SIDEBAR_COLLAPSED=true

# UI Theme Configuration (Testing)
UI_DEFAULT_THEME=light
UI_ENABLE_THEME_TOGGLE=false
UI_PRESERVE_THEME_CHOICE=false

# Demo UI Kit Configuration (Testing - ALL DISABLED)
DEMO_SHOW_BUTTONS=false
DEMO_SHOW_CARDS=false
DEMO_SHOW_FORMS=false
DEMO_SHOW_ALERTS=false
DEMO_SHOW_MODALS=false
DEMO_SHOW_NAVIGATION=false
DEMO_SHOW_TYPOGRAPHY=false
DEMO_SHOW_LAYOUTS=false
DEMO_SHOW_TABLES=false
DEMO_SHOW_BADGES=false
DEMO_SHOW_AVATARS=false
DEMO_SHOW_PROGRESS=false
DEMO_SHOW_TABS=false
DEMO_SHOW_DROPDOWNS=false
DEMO_SHOW_PAGINATION=false
DEMO_SHOW_CODE=false
DEMO_ENABLE_CLIPBOARD=false
DEMO_SYNTAX_HIGHLIGHTING=false

# Performance Configuration (Testing - Disabled)
PERFORMANCE_LAZY_LOAD=false
PERFORMANCE_PRELOAD_CSS=false
PERFORMANCE_OPTIMIZE_IMAGES=false
PERFORMANCE_RESPONSE_CACHE=false
PERFORMANCE_CACHE_DURATION=0

# Security Configuration (Testing - Relaxed for speed)
SECURITY_PASSWORD_HISTORY=false
SECURITY_PASSWORD_HISTORY_COUNT=0
SECURITY_FORCE_PASSWORD_CHANGE=0
SECURITY_LOG_LOGIN_ATTEMPTS=false
SECURITY_MAX_LOGIN_ATTEMPTS=999
SECURITY_LOCKOUT_MINUTES=0

# Development Configuration (Testing - Disabled)
BOILERPLATE_DEBUG_INFO=false
BOILERPLATE_QUERY_LOG=false
BOILERPLATE_ROUTE_INFO=false
BOILERPLATE_PROFILING=false

# Laravel Testing Configuration
LOG_LEVEL=emergency
LOG_CHANNEL=single
BCRYPT_ROUNDS=4

# Testing Specific
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
