# ====================================
# CI/CD Environment Template
# ====================================
# Optimized for GitHub Actions, GitLab CI, or other CI/CD pipelines
# Fast, reliable, and isolated testing environment

# Laravel Core Configuration (CI)
APP_NAME="Laravel Boilerplate CI"
APP_ENV=testing
APP_KEY=base64:TESTING_KEY_FOR_CI_PIPELINE_ONLY
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Localization (CI - English for consistency)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Application Assets and Branding (CI - minimal)
APP_LOGO_LIGHT=/images/logo.svg
APP_LOGO_DARK=/images/logo-dark.svg
APP_FAVICON=/favicon.ico
BRAND_PRIMARY_COLOR=#3b82f6
BRAND_SECONDARY_COLOR=#64748b

# Database Configuration (CI - SQLite in memory)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# Session and Cache Configuration (CI - Array drivers)
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=array
CACHE_PREFIX=ci_

# Queue Configuration (CI - Synchronous)
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Configuration (CI - Array driver)
MAIL_MAILER=array
MAIL_FROM_ADDRESS="ci@boilerplate.test"
MAIL_FROM_NAME="${APP_NAME}"

# Redis Configuration (CI - Array/Mock)
REDIS_CLIENT=array

# Vite Configuration (CI)
VITE_APP_NAME="${APP_NAME}"

# ====================================
# BOILERPLATE FEATURES (CI - Testing Focus)
# ====================================

# Core Features (CI - Minimal but functional)
BOILERPLATE_DEMO_UI=false
BOILERPLATE_ACTIVITY_LOG=true
BOILERPLATE_STRICT_PERMISSIONS=true
BOILERPLATE_MULTI_LANGUAGE=false
BOILERPLATE_THEME_SWITCHING=false

# Admin Panel Configuration (CI)
ADMIN_LOCALE=en
ADMIN_ITEMS_PER_PAGE=10
ADMIN_ENABLE_AVATARS=false
ADMIN_ENABLE_GLOBAL_SEARCH=false
ADMIN_ENABLE_DB_NOTIFICATIONS=false
ADMIN_SIDEBAR_COLLAPSED=true

# UI Theme Configuration (CI)
UI_DEFAULT_THEME=light
UI_ENABLE_THEME_TOGGLE=false
UI_PRESERVE_THEME_CHOICE=false

# Demo UI Kit Configuration (CI - ALL DISABLED)
DEMO_SHOW_BUTTONS=false
DEMO_SHOW_CARDS=false
DEMO_SHOW_FORMS=false
DEMO_SHOW_ALERTS=false
DEMO_SHOW_MODALS=false
DEMO_SHOW_NAVIGATION=false
DEMO_SHOW_TYPOGRAPHY=false
DEMO_SHOW_LAYOUTS=false
DEMO_SHOW_TABLES=false
DEMO_SHOW_BADGES=false
DEMO_SHOW_AVATARS=false
DEMO_SHOW_PROGRESS=false
DEMO_SHOW_TABS=false
DEMO_SHOW_DROPDOWNS=false
DEMO_SHOW_PAGINATION=false
DEMO_SHOW_CODE=false
DEMO_ENABLE_CLIPBOARD=false
DEMO_SYNTAX_HIGHLIGHTING=false

# Performance Configuration (CI - Disabled for testing)
PERFORMANCE_LAZY_LOAD=false
PERFORMANCE_PRELOAD_CSS=false
PERFORMANCE_OPTIMIZE_IMAGES=false
PERFORMANCE_RESPONSE_CACHE=false
PERFORMANCE_CACHE_DURATION=0

# Security Configuration (CI - Relaxed for testing)
SECURITY_PASSWORD_HISTORY=false
SECURITY_PASSWORD_HISTORY_COUNT=0
SECURITY_FORCE_PASSWORD_CHANGE=0
SECURITY_LOG_LOGIN_ATTEMPTS=false
SECURITY_MAX_LOGIN_ATTEMPTS=999
SECURITY_LOCKOUT_MINUTES=0

# Development Configuration (CI - Disabled)
BOILERPLATE_DEBUG_INFO=false
BOILERPLATE_QUERY_LOG=false
BOILERPLATE_ROUTE_INFO=false
BOILERPLATE_PROFILING=false

# Laravel CI Configuration
LOG_LEVEL=emergency
LOG_CHANNEL=stderr
BCRYPT_ROUNDS=4

# CI/CD Specific Configuration
CI=true
GITHUB_ACTIONS=true

# Disable external services in CI
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

# Performance optimizations for CI
SCOUT_DRIVER=null
MAIL_MAILER=array

# Test Coverage and Reporting
COVERAGE_CLOVER=coverage.xml
COVERAGE_HTML=coverage-html

# Node.js and NPM Configuration for CI
NODE_ENV=testing
NPM_CONFIG_PROGRESS=false
NPM_CONFIG_SPIN=false
