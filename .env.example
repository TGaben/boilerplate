# Laravel Application Configuration
APP_NAME="Laravel Boilerplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Application Assets and Branding
APP_LOGO_LIGHT=/images/logo.svg
APP_LOGO_DARK=/images/logo-dark.svg
APP_FAVICON=/favicon.ico
BRAND_PRIMARY_COLOR=#3b82f6
BRAND_SECONDARY_COLOR=#64748b

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Broadcast Driver
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Session and Cache Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Redis Configuration (optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# Boilerplate Features Configuration
BOILERPLATE_DEMO_UI=true
BOILERPLATE_ACTIVITY_LOG=true
BOILERPLATE_STRICT_PERMISSIONS=true
BOILERPLATE_MULTI_LANGUAGE=true
BOILERPLATE_THEME_SWITCHING=true

# Admin Panel Configuration
ADMIN_LOCALE=hu
ADMIN_ITEMS_PER_PAGE=25
ADMIN_ENABLE_AVATARS=true
ADMIN_ENABLE_GLOBAL_SEARCH=true
ADMIN_ENABLE_DB_NOTIFICATIONS=true
ADMIN_SIDEBAR_COLLAPSED=false

# UI Theme Configuration
UI_DEFAULT_THEME=light
UI_ENABLE_THEME_TOGGLE=true
UI_PRESERVE_THEME_CHOICE=true

# Demo UI Kit Configuration
DEMO_SHOW_BUTTONS=true
DEMO_SHOW_CARDS=true
DEMO_SHOW_FORMS=true
DEMO_SHOW_ALERTS=true
DEMO_SHOW_MODALS=true
DEMO_SHOW_NAVIGATION=true
DEMO_SHOW_TYPOGRAPHY=true
DEMO_SHOW_LAYOUTS=true
DEMO_SHOW_TABLES=true
DEMO_SHOW_BADGES=true
DEMO_SHOW_AVATARS=true
DEMO_SHOW_PROGRESS=true
DEMO_SHOW_TABS=true
DEMO_SHOW_DROPDOWNS=true
DEMO_SHOW_PAGINATION=true
DEMO_SHOW_CODE=true
DEMO_ENABLE_CLIPBOARD=true
DEMO_SYNTAX_HIGHLIGHTING=true

# Performance Configuration
PERFORMANCE_LAZY_LOAD=true
PERFORMANCE_PRELOAD_CSS=true
PERFORMANCE_OPTIMIZE_IMAGES=true
PERFORMANCE_RESPONSE_CACHE=false
PERFORMANCE_CACHE_DURATION=60

# Security Configuration
SECURITY_PASSWORD_HISTORY=false
SECURITY_PASSWORD_HISTORY_COUNT=5
SECURITY_FORCE_PASSWORD_CHANGE=0
SECURITY_LOG_LOGIN_ATTEMPTS=true
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15

# Development Configuration (disable in production!)
BOILERPLATE_DEBUG_INFO=false
BOILERPLATE_QUERY_LOG=false
BOILERPLATE_ROUTE_INFO=false
BOILERPLATE_PROFILING=false

# Testing Configuration
# For running tests, copy this file to .env.testing and modify as needed
# Example:
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:
# CACHE_STORE=array
# SESSION_DRIVER=array
# QUEUE_CONNECTION=sync
# MAIL_MAILER=array

# Laravel Scout Configuration
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX="${APP_NAME}_"
SCOUT_QUEUE=false

# Meilisearch Configuration  
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
MEILI_NO_ANALYTICS=true
MEILI_ENV=development
MEILI_MASTER_KEY=

# Docker Meilisearch Port
FORWARD_MEILISEARCH_PORT=7700
